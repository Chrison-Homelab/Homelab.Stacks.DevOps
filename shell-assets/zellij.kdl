// zellij.kdl — canonical Zellij config for the shell host (superproject #479).
//
// Installed by ShellProvisioner to ~/.config/zellij/config.kdl. `__HOME__` is substituted
// with the login user's home at install time — zellij wants absolute paths for the cert and
// key, and hardcoding /home/csimon here would silently break if the shape's `user:` changed.
//
// ⚠ THIS FILE EXISTING IS LOAD-BEARING, not cosmetic. `zellij` itself runs happily on built-in
//   defaults, but `zellij web` logs "Failed to find default config file path" and exits about a
//   second AFTER printing "Web Server started on ...". The success line is the last thing on
//   stdout and nothing listens. Deleting this file breaks the browser terminal in a way that
//   looks like it is working.
//
// Only overrides live here. Anything absent keeps zellij's built-in default, which is why this
// is 30 lines instead of the 615 that `zellij setup --dump-config` emits — there is no value in
// owning a copy of upstream's defaults that silently goes stale.

// ── Locked by default, and this is the important line ─────────────────────────────────
// Zellij's normal mode claims Ctrl-p/n/o/t/h/b/s/q. The whole point of this host is running a
// TUI inside it — Claude Code (#421) — and those are exactly the keys such an app wants. In
// locked mode zellij passes keys through to the application and gets out of the way; Ctrl-g
// unlocks when you actually want the multiplexer. This is upstream's "unlock-first" posture,
// expressed as config rather than by adopting the whole preset.
default_mode "locked"

// ── Web client ────────────────────────────────────────────────────────────────────────
// 0.0.0.0, because the Newt connector lives in its OWN container (CT 3005) and reaches this
// host over the LAN, not over loopback. That is also why the cert below is not optional:
//   $ zellij web --ip 0.0.0.0
//   Cannot bind to non-loopback IP: 0.0.0.0 without an SSL certificate.
// There is no insecure-behind-a-proxy override (zellij-org/zellij#4378 is open).
web_server_ip "0.0.0.0"
web_server_port 8082

// Self-signed, generated by converge, and validated by nothing: `.internal` is not a real TLD
// so no CA can issue for it, and an internal CA was ruled out deliberately (see
// Infrastructure/unifi/network.yaml). Traefik reaches this target with insecureSkipVerify.
web_server_cert "__HOME__/.config/zellij/web-cert.pem"
web_server_key "__HOME__/.config/zellij/web-key.pem"

// Let terminal-started sessions be attached from the browser. Without this the web client can
// only see sessions it started itself, which defeats the point of one long-lived session.
web_sharing "on"

// Deliberately NOT `web_server true`. That would have every new session ensure a web server is
// running, giving the process two owners — systemd (zellij-web.service, with Restart=on-failure)
// and any session that happens to start. One owner is easier to reason about when it misbehaves.
